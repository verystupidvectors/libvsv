CC=C:\MSDEV\BIN\CL.EXE
LINK=C:\MSDEV\BIN\LINK.EXE
CFLAGS=/nologo /W3 /O2
!IFNDEF LIB
LIB=C:\MSDEV\LIB
!ENDIF
!IFNDEF INCLUDE
INCLUDE=C:\MSDEV\INCLUDE
!ENDIF

all: VSV.DLL

#SET INCLUDE=$(INCLUDE) && 
VSV.OBJ: VSV.C VSV.H
  $(CC) $(CFLAGS) /c VSV.C

#SET LIB=$(LIB) && 
VSV.DLL: VSV.OBJ
  $(LINK) /nologo /DLL /OUT:VSV.DLL VSV.OBJ

clean:
  - del VSV.OBJ
  - del VSV.DLL



